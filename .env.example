# ZORO AI — environment placeholders only. Never commit real secrets.
# Copy to .env.local for local development.

# Optional: LLM planner (OpenAI-compatible). Leave empty to use the built-in offline planner.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=

# Optional: Replicate video provider (PAID — pay per generation). Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Example model IDs must be verified on the provider site before use (owner/name or owner/name:version-id).
REPLICATE_VIDEO_MODEL=

# Optional: Hugging Face Inference Providers (usage may bill to your HF account). Token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_VIDEO_MODEL=

# YOUR OWN MODEL (no dependence on anyone): run worker-server/example.py
# (or any server following worker-server/README) and point here. No key needed.
# Leave commented out until your server is actually running.
# WORKER_URL=http://127.0.0.1:8188
WORKER_MAX_CLIP_SEC=5

# Optional: Pollinations free tier upgrades (all free features work WITHOUT these).
# Free registration at https://auth.pollinations.ai raises rate limits and unlocks watermark removal.
POLLINATIONS_TOKEN=
POLLINATIONS_REFERRER=zoro-ai-local
POLLINATIONS_TEXT_MODEL=openai
# Set to 1 to skip the free hosted planner and use only the offline planner.
ZORO_DISABLE_FREE_PLANNER=

# Optional: public base URL of this app (used to hand reference images to remote providers)
PUBLIC_BASE_URL=http://localhost:3000

# Storage dir for projects/media (defaults to ./data)
ZORO_DATA_DIR=./data
